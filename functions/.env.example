# App Check é obrigatório fora do Firebase Emulator Suite.
# Cadastre o domínio de produção e configure NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY no frontend.
# disabled saves internal orders without external dispatch.
# local is allowed ONLY when the Firebase emulators supply FUNCTIONS_EMULATOR=true.
# saipos persists orders but fails closed until official order contract + homologation exist.
ORDER_PROVIDER=disabled
LOCAL_PROVIDER_SCENARIO=accept
# Scenarios: accept | reject | timeout | transient | permanent
# No Saipos URL, auth mechanism or credentials invented. See docs/saipos-integration.md.
