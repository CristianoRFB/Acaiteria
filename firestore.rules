rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userRole() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null; }
    function isStaff() { return userRole() == 'staff' || userRole() == 'admin'; }
    function isAdmin() { return userRole() == 'admin'; }

    match /storePublicConfig/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /storePrivateConfig/{id} {
      allow read, write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if isStaff() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }
    match /products/{id} {
      allow read: if isStaff() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }
    match /modifierGroups/{id} {
      allow read: if isStaff() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }
    match /modifiers/{id} {
      allow read: if isStaff() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }
    match /promotions/{id} {
      allow read: if isStaff() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }
    match /financeEntries/{id} {
      allow read: if isStaff();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }
    match /cashControl/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /cashRegisters/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /cashMovements/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /orders/{id} {
      allow read: if isStaff() || (!signedIn() && resource.data.publicCode == id);
      allow create: if request.resource.data.publicCode == id
        && request.resource.data.status == 'NEW'
        && request.resource.data.orderNumber is string
        && request.resource.data.customer.name is string
        && request.resource.data.customer.whatsapp is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.pricing.totalCents is int
        && request.resource.data.pricing.totalCents >= 0
        && request.resource.data.fulfillment.mode in ['PICKUP', 'DELIVERY']
        && request.resource.data.payment.method in ['PIX', 'CARD', 'CASH'];
      allow delete: if false;
      // A staff member may correct contact/address/notes while the order is still new.
      // Status changes continue to go through the validated callable function.
      allow update: if isStaff()
        && resource.data.status in ['NEW', 'CONFIRMED']
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customer', 'notes', 'items', 'pricing', 'fulfillment', 'payment', 'updatedAt', 'lastEditedAt', 'lastEditedBy', 'customerEditApproval', 'estimatedMinutes', 'estimatedUpdatedAt']);
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusHistory', 'updatedAt', 'cancelledAt', 'cancellationReason', 'estimatedMinutes', 'estimatedUpdatedAt'])
        && request.resource.data.status != 'COMPLETED'
        && (
          (resource.data.status == 'NEW' && request.resource.data.status in ['CONFIRMED', 'CANCELLED']) ||
          (resource.data.status == 'CONFIRMED' && request.resource.data.status in ['PREPARING', 'CANCELLED']) ||
          (resource.data.status == 'PREPARING' && request.resource.data.status in ['READY', 'CANCELLED']) ||
          (resource.data.status == 'READY' && request.resource.data.status in ['OUT_FOR_DELIVERY', 'COMPLETED', 'CANCELLED']) ||
          (resource.data.status == 'OUT_FOR_DELIVERY' && request.resource.data.status == 'COMPLETED')
        );
    }
    match /publicOrders/{id} {
      allow read: if true;
      allow create: if request.resource.data.publicCode == id
        && request.resource.data.status == 'NEW'
        && request.resource.data.orderNumber is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.pricing.totalCents is int;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusMessage', 'estimatedMinutes', 'estimatedUpdatedAt', 'updatedAt', 'editProposal'])
        && (
          request.resource.data.status == resource.data.status
          || (resource.data.status == 'NEW' && request.resource.data.status in ['CONFIRMED', 'CANCELLED'])
          || (resource.data.status == 'CONFIRMED' && request.resource.data.status in ['PREPARING', 'CANCELLED'])
          || (resource.data.status == 'PREPARING' && request.resource.data.status in ['READY', 'CANCELLED'])
          || (resource.data.status == 'READY' && request.resource.data.status in ['OUT_FOR_DELIVERY', 'CANCELLED'])
          || (resource.data.status == 'OUT_FOR_DELIVERY' && request.resource.data.status == 'CANCELLED')
        );
      // O cliente pode apenas responder a uma proposta pendente; itens, preços e status continuam protegidos.
      allow update: if !signedIn()
        && resource.data.publicCode == id
        && resource.data.editProposal is map
        && resource.data.editProposal.status == 'PENDING'
        && request.resource.data.editProposal is map
        && request.resource.data.editProposal.status in ['ACCEPTED', 'REJECTED']
        && request.resource.data.editProposal.diff(resource.data.editProposal).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['editProposal', 'updatedAt']);
      allow delete: if false;
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /orderRequests/{id} { allow read, write: if false; }
    match /integrationConfig/{id} { allow read, write: if false; }
    match /orders/{id}/integrationAttempts/{attempt} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
